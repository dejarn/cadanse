generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id             String        @id @default(uuid())
  username       String        @unique
  hashedPassword String
  role           Role
  createdAt      DateTime      @default(now())

  inviteTokens   InviteToken[]

  @@map("users")
}

model InviteToken {
  id        String    @id @default(uuid())
  token     String    @unique @default(uuid())
  createdBy String
  expiresAt DateTime
  usedAt    DateTime?

  creator   User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

// ─── Domain ──────────────────────────────────────────────────────────────────

model Season {
  id        String   @id @default(uuid())
  label     String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  classes   Class[]
  shows     Show[]

  @@map("seasons")
}

model Teacher {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  displayName String?
  createdAt   DateTime @default(now())

  classes   Class[]

  @@map("teachers")
}

model Student {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  createdAt DateTime @default(now())

  enrollments        StudentClass[]
  showParticipations ShowParticipation[]
  actParticipations  ActParticipation[]
  placements         Placement[]

  @@map("students")
}

model Class {
  id        String   @id @default(uuid())
  name      String
  schedule  String
  teacherId String
  seasonId  String
  createdAt DateTime @default(now())

  teacher     Teacher        @relation(fields: [teacherId], references: [id])
  season      Season         @relation(fields: [seasonId], references: [id])
  enrollments StudentClass[]
  acts        Act[]

  @@index([seasonId])
  @@index([teacherId])
  @@map("classes")
}

model StudentClass {
  studentId String
  classId   String

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([studentId, classId])
  @@index([classId])
  @@index([studentId])
  @@map("student_classes")
}

model Show {
  id              String    @id @default(uuid())
  name            String
  date            DateTime    @db.Date
  seasonId        String
  currentPosition Int?
  createdAt       DateTime  @default(now())

  season             Season              @relation(fields: [seasonId], references: [id])
  acts               Act[]
  actPositions       ActPosition[]
  showParticipations ShowParticipation[]

  @@unique([name, seasonId])
  @@index([seasonId])
  @@map("shows")
}

model Act {
  id            String   @id @default(uuid())
  name          String
  description   String?
  classId       String?
  showId        String
  fixedPosition Int?
  duration      Int?
  createdAt     DateTime @default(now())

  class        Class?        @relation(fields: [classId], references: [id])
  show         Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  actPositions ActPosition[]
  participations ActParticipation[]
  scenes        Scene[]

  @@index([showId])
  @@index([classId])
  @@map("acts")
}

model ShowParticipation {
  showId    String
  studentId String

  show    Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([showId, studentId])
  @@index([showId])
  @@index([studentId])
  @@map("show_participations")
}

model ActPosition {
  showId   String
  actId    String
  position Int

  show     Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  act      Act    @relation(fields: [actId], references: [id], onDelete: Cascade)

  @@id([showId, actId])
  @@map("act_positions")
}

model ActParticipation {
  actId     String
  studentId String
  color     Int      @default(0)

  act     Act     @relation(fields: [actId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([actId, studentId])
  @@index([studentId])
  @@map("act_participations")
}

model Scene {
  id        String   @id @default(uuid())
  name      String
  order     Int
  actId     String
  createdAt DateTime @default(now())

  act        Act         @relation(fields: [actId], references: [id], onDelete: Cascade)
  placements Placement[]

  @@index([actId])
  @@map("scenes")
}

model Placement {
  id        String @id @default(uuid())
  x         Float
  y         Float
  sceneId   String
  studentId String

  scene   Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sceneId, studentId])
  @@index([sceneId])
  @@index([studentId])
  @@map("placements")
}
